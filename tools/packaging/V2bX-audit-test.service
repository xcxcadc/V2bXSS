# Isolated test service; never replaces an upstream V2bX service.
[Unit]
Description=V2bX audit extension test node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/etc/v2bx-audit-test
ExecStart=/opt/v2bx-audit-test/current/V2bX server --config /etc/v2bx-audit-test/config.json --watch=false
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
